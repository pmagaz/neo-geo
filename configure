#!/bin/sh
# Generate config.mk: where this machine's ngdevkit toolchain lives.
# Run once after checkout (and again if you move or upgrade ngdevkit).
set -e

BREW_PREFIX=$(brew --prefix 2>/dev/null || echo /usr/local)
PATH="$BREW_PREFIX/opt/python@3.14/bin:$BREW_PREFIX/bin:$PATH"
export PATH

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "error: $1 not found in PATH." >&2
        echo "       install it with: $2" >&2
        exit 1
    }
    command -v "$1"
}

PKGCONFIG=$(need pkg-config "brew install pkg-config")
need m68k-neogeo-elf-gcc "brew tap dciabrin/ngdevkit && brew install ngdevkit" >/dev/null
need gmake "brew install make" >/dev/null
need magick "brew install imagemagick" >/dev/null
# sox converts the sound effects to the rate the ADPCM chip needs. Without it
# the build used to carry on and fail much later, inside vromtool.
need sox "brew install sox" >/dev/null
need zip "brew install zip" >/dev/null
need z80-neogeo-ihx-sdasz80 "brew install ngdevkit" >/dev/null

PYTHON=$(need python3 "brew install python3")
NGBIN=$(dirname "$(command -v tiletool.py)")

# GnGeo ships its data file under its own prefix; there is no pkg-config entry.
GNGEO_BIN=$(need ngdevkit-gngeo "brew install ngdevkit-gngeo")
GNGEO_SHARE=$(cd "$(dirname "$GNGEO_BIN")/.." && pwd)/share/ngdevkit-gngeo
if [ ! -f "$GNGEO_SHARE/gngeo_data.zip" ]; then
    GNGEO_SHARE=$(brew --prefix ngdevkit-gngeo 2>/dev/null)/share/ngdevkit-gngeo
fi

cat > config.mk <<EOF
# Generated by ./configure - do not edit, and do not commit.
# Absolute paths to this machine's ngdevkit toolchain.

PKGCONFIG=$PKGCONFIG
PYTHON=$PYTHON
ZIP=$(command -v zip)

# 68000 toolchain
M68KAR=$(command -v m68k-neogeo-elf-ar)
M68KAS=$(command -v m68k-neogeo-elf-as)
M68KGCC=$(command -v m68k-neogeo-elf-gcc)
M68KGXX=$(command -v m68k-neogeo-elf-g++)
M68KLD=$(command -v m68k-neogeo-elf-ld)
M68KOBJCOPY=$(command -v m68k-neogeo-elf-objcopy)
M68KRANLIB=$(command -v m68k-neogeo-elf-ranlib)

# Z80 (sound) toolchain
Z80SDAR=$(command -v z80-neogeo-ihx-sdar)
Z80SDAS=$(command -v z80-neogeo-ihx-sdasz80)
Z80SDCC=$(command -v z80-neogeo-ihx-sdcc)
Z80SDLD=$(command -v z80-neogeo-ihx-sdldz80)
Z80SDOBJCOPY=$(command -v z80-neogeo-ihx-sdobjcopy)
Z80SDRANLIB=$(command -v z80-neogeo-ihx-sdranlib)

# asset tools
PALTOOL=$NGBIN/paltool.py
TILETOOL=$NGBIN/tiletool.py
ADPCMTOOL=$NGBIN/adpcmtool.py
VROMTOOL=$NGBIN/vromtool.py
FURTOOL=$NGBIN/furtool.py
NSSTOOL=$NGBIN/nsstool.py
SOUNDTOOL=$NGBIN/soundtool.py
ROMTOOL=$NGBIN/romtool.py

# ngdevkit build flags
NGCFLAGS=\`\$(PKGCONFIG) --cflags ngdevkit\`
NGLDFLAGS=\`\$(PKGCONFIG) --libs ngdevkit\`
NGLIBDIR=\`\$(PKGCONFIG) --variable=libdir ngdevkit\`
NGZ80INCLUDEDIR=\`\$(PKGCONFIG) --variable=z80includedir ngdevkit\`
NGZ80LIBDIR=\`\$(PKGCONFIG) --variable=z80libdir ngdevkit\`
NGSHAREDIR=\$(shell \$(PKGCONFIG) --variable=sharedir ngdevkit)

# open source BIOS shipped with ngdevkit - no copyrighted ROMs needed
AES_BIOS=\$(NGSHAREDIR)/aes.zip
MVS_BIOS=\$(NGSHAREDIR)/neogeo.zip

# additional tools
CONVERT=$(command -v magick)
SOX=$(command -v sox)
RSYNC=$(command -v rsync)
GNGEO=$(command -v ngdevkit-gngeo)

# GnGeo: plain rendering, no CRT shader
GNGEO_DATA=$GNGEO_SHARE/gngeo_data.zip
GNGEO_GLSL=no
GNGEO_SHADER_PATH=
GLSL_SHADER_PATH=
SHADER_PATH=
SHADER=

# OS-specific
ENABLE_MSYS2=
ENABLE_MINGW=no
GNGEO_INSTALL_PATH=
EOF

echo "config.mk written. Build with: gmake"
