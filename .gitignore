# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# These are backup files generated by rustfmt
**/*.rs.bk
# Neo Geo cartridge build output
/build/
# generated by ./configure - holds absolute paths to this machine's toolchain
/config.mk

# intermediate files produced by the setup/ngdevkit-assets step
setup/ngdevkit-assets/rom/
setup/ngdevkit-assets/*.lst
setup/ngdevkit-assets/*.rel
setup/ngdevkit-assets/*.map
setup/ngdevkit-assets/*.ihx
setup/ngdevkit-assets/*.lib
setup/ngdevkit-assets/*.bmp
setup/ngdevkit-assets/*.gif
setup/ngdevkit-assets/tmp.*
setup/ngdevkit-assets/samples.inc
setup/ngdevkit-assets/instruments-*.s
setup/ngdevkit-assets/nss-*.s

secrets/
dist/
**/dist/
.env
.env.example
.env.*
.DS_Store
__MACOSX/
.claude/